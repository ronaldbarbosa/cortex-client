{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cortex-client",
  "compatibility_date": "2026-05-10",
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "dist/cortex-client/browser",
    "not_found_handling": "single-page-application",
  },
  "compatibility_flags": ["nodejs_compat"],
}
